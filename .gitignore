# Environment configuration
.env
# Note: config.php is now tracked with default settings for easy XAMPP deployment
# Make sure to update sensitive values after deployment

# Logs directory but keep structure
logs/*
!logs/.gitkeep

# Uploaded files
uploads/csv/*
!uploads/csv/.gitkeep
uploads/templates/*
!uploads/templates/.gitkeep

# Generated files
generated/certificates/*
!generated/certificates/.gitkeep
generated/qrcodes/*
!generated/qrcodes/.gitkeep

# Dependencies (if using Composer)
vendor/
composer.lock

# System files
.DS_Store
Thumbs.db
*.log

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
tmp/
temp/
*.tmp

# Backup files
*.bak
*.backup
*.sql.gz
